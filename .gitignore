# ============================================================
# RailOptima — .gitignore
# ============================================================

# ── Артефакты сборки Unreal Engine ────────────────────────
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
*.VC.db
*.VC.opendb

# ── IDE: Visual Studio, Rider, VSCode ─────────────────────
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.user
*.userprefs
*.csproj
*.props
*.targets
.vsconfig

# ── Логи, кэши, временные ─────────────────────────────────
*.log
*.bak
*.tmp
*.swp
*~

# ── ОС ─────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.directory

# ── Экспорт из приложения ─────────────────────────────────
/Exports/
*.xlsx

# ── ГИС-мусор рядом с картами высот ───────────────────────
*.aux.xml
*.ovr

# ── ThirdParty: только build/, lib/ оставляем ─────────────
# *.lib нужны для линковки, их коммитим.
/Source/ThirdParty/**/build/
*.pdb