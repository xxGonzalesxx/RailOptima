# ============================================================
# RailOptima — .gitignore для Unreal Engine 5
# Принцип: игнорируем всё, затем разрешаем только нужное
# ============================================================

# 1. Игнорируем все файлы по умолчанию, но сканируем все директории
*
!*/

# 2. Разрешаем git-файлы в корне репозитория
!/.git*
!/.gitattributes
!/.gitignore

# 3. Разрешаем файл проекта Unreal
!/*.uproject

# 4. Разрешаем директории с исходным кодом, конфигами и плагинами
!/Source/**
!/Config/**
!/Plugins/**

# 5. Разрешаем только файлы ассетов (.uasset, .umap) из Content
#    Все остальные типы файлов в Content будут проигнорированы
!/Content/**/*.uasset
!/Content/**/*.umap

# 6. Разрешаем директорию RawContent для исходных (raw) ассетов
#    Всё содержимое этой папки будет управляться через Git LFS
!/RawContent/**/*

# 7. Разрешаем файлы документации и лицензии
!/README.md
!/LICENSE
!/CHANGELOG.md

# ============================================================
# Игнорируемые директории и файлы (генерируются автоматически)
# ============================================================

# Артефакты сборки Unreal Engine
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Файлы Visual Studio / Rider
.vs/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Файлы сборки C#
*.csproj
*.props
*.targets

# Временные файлы ОС
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# Vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Логи и отладочные данные
*.log
*.bak
*.tmp

# Экспортированные данные (Excel-отчёты, JSON для API)
/Exports/
*.xlsx

# ============================================================
# ThirdParty: игнорируем собранные библиотеки, но не заголовки
# ============================================================
/Source/ThirdParty/**/lib/
/Source/ThirdParty/**/bin/
/Source/ThirdParty/**/build/
*.lib
*.dll
*.so
*.dylib
*.a